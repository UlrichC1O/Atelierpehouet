APP_NAME="Ateliers Pehouet"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Hosted Postgres (e.g. Supabase): DB_CONNECTION=pgsql plus the connection URL.
# DB_URL=
# DB_SEARCH_PATH=public
# DB_EMULATE_PREPARES=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Ateliers Pehouet -------------------------------------------------------
# Public contact details (leave empty to hide). Replace the placeholders!
ATELIER_EMAIL=contact@example.com
ATELIER_NOTIFY_EMAIL=
ATELIER_PHONE=
ATELIER_WHATSAPP=
ATELIER_ADDRESS=
ATELIER_INSTAGRAM=
ATELIER_FACEBOOK=
ATELIER_TIKTOK=
ATELIER_YOUTUBE=

# Admin CMS (/admin, docs/CMS.md). The first administrator is created at the first login
# with these credentials while no user exists (or run: php artisan atelier:admin you@example.org).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Where photos are stored: database (base64 rows, works on read-only hosts) | filesystem (storage/app/media)
CMS_MEDIA_DRIVER=database
# Cache of the CMS data read by the public pages: store (empty = CACHE_STORE) and lifetime in seconds.
CMS_CACHE_STORE=
CMS_CACHE_TTL=600
# Seconds an unreachable database is skipped (circuit breaker) before the site tries it again.
CMS_CACHE_RETRY=30
# Seconds the pages wait for an unreachable Postgres database before using the file defaults
# (libpq applies it to each address the host resolves to).
DB_TIMEOUT=2
# Hosted Postgres (Supabase): also bound how long a query may run and pin the schema, once, in the
# SQL editor (replace the role with the one of DB_URL):
#   ALTER ROLE postgres SET statement_timeout = '5s';
#   ALTER ROLE postgres SET search_path TO laravel;
# (or per connection: SET statement_timeout = '5s'; SET search_path TO laravel;) and DB_SEARCH_PATH=laravel.

# Python generative-art engine (python/art_engine). The site falls back to the
# engine's CLI, then to a built-in SVG, when the HTTP service is not running.
ART_ENGINE_URL=http://127.0.0.1:8765
ART_ENGINE_TIMEOUT=2.5
ART_ENGINE_CLI=true
ART_ENGINE_PYTHON=python3
