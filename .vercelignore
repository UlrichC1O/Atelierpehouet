# Vercel installs Composer dependencies itself (no dev packages) — see vercel.json.
/vendor
/node_modules
/.env
/.env.backup
/.env.production
/.phpunit.cache
/bootstrap/cache/*.php
/database/*.sqlite*
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
# public/ is served as static files: never ship PHP source there (Vercel would serve
# public/index.php as the page for "/"). The function boots through api/index.php.
/public/index.php
/public/.htaccess
