{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "outputDirectory": "public",
    "regions": ["cdg1"],
    "fluid": false,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "maxDuration": 30,
            "excludeFiles": "{node_modules/**,tests/**,docs/**,storage/**,database/*.sqlite,vercel.json,.vercelignore}"
        }
    },
    "routes": [
        { "src": "/(index\\.php|\\.htaccess)?", "dest": "/api/index.php" },
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ]
}
